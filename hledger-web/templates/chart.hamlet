$# The chart is SVG, drawn by the server as wide as the page's main column,
$# and styled by /chart.css. With several commodities, a legend chooses the
$# one charted: its entries are the labels of radio buttons, each followed
$# by its commodity's chart, which the css shows while it is chosen, with no
$# javascript. hledger.js lets you drag across a plot to see the
$# transactions on those dates, for which it reads each plot's date scale,
$# and data-baselink, the register's url without its date terms. Keeping
$# data and code out of the page is what lets script-src be strict (#2703).
$if not (null panels)
  $if length panels == 1
    <div .register-chart data-baselink=@?{nodatelink}>
      #{svg panels}
      $if leftout > 0
        <p .chart-note>#{moreCommodities trs leftout}
  $else
    <div .register-chart .with-legend data-baselink=@?{nodatelink}>
      <span .chart-legend-label>#{balancelabel}:
      $forall (k, p, name, first) <- legend
        <input type=radio name=register-chart id="register-chart-#{show k}" :first:checked>
        <label for="register-chart-#{show k}">#{name}
        <div .chart-panel>#{svg [p]}
      $if leftout > 0
        <p .chart-note>#{moreCommodities trs leftout}
