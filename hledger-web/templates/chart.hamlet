<label #register-chart-label style=""><br>
<canvas id="registerChartCanvas" style="height:25rem; width:100%; display:block; margin-top:.5rem;"></canvas>
<script type=text/javascript>
  (() => {
    try {
      const canvas = document.getElementById('registerChartCanvas');
      if (!canvas) return;
      
      const charttitle = '#{charttitle}';
      const label = document.getElementById('register-chart-label');
      label.textContent = charttitle;
      if (charttitle === 'Period Total:') {
        label.style.fontWeight = 'bold';
      }
      
      const colors = ['#edc240', '#afd8f8', '#cb4b4b', '#4da74d', '#9440ed', '#e0e0e0'];
      
      const datasets = [];
      const pointMetadata = [];
      $forall (c,items) <- percommoditytxnreports
        {
          const colorIndexVal = #{colorForCommodity c};
          const color = colors[colorIndexVal % colors.length];
          datasets.push({
            label: '#{shownull $ T.unpack c}',
            data: [
              $forall i <- reverse items
                { x: #{dayToUtcNoonTimestamp $ triDate i}, y: Number('#{simpleMixedAmountQuantity $ triCommodityBalance c i}') },
            ],
            borderColor: color,
            backgroundColor: color,
            stepped: true,
            pointRadius: 0,
            pointHoverRadius: 0,
            tension: 0,
          });
          
          pointMetadata.push(
            $forall i <- reverse items
              {
                amount: '#{showZeroCommodity $ triCommodityAmount c i}',
                balance: '#{showZeroCommodity $ triCommodityBalance c i}',
                transaction: '#{concat $ intersperse "\\n" $ lines $ T.unpack $ showTransaction $ triOrigTransaction i}',
                tindex: #{tindex $ triOrigTransaction i}
              },
          );
          
          datasets.push({
            label: '',
            data: [
              $forall i <- reverse items
                { x: #{dayToUtcNoonTimestamp $ triDate i}, y: Number('#{simpleMixedAmountQuantity $ triCommodityBalance c i}') },
            ],
            borderColor: color,
            backgroundColor: color,
            pointRadius: 4,
            pointHoverRadius: 6,
            showLine: false,
          });
        }
      
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      
      // Custom plugin to draw background markings like the original flot chart
      const backgroundMarkingsPlugin = {
        id: 'backgroundMarkings',
        beforeDraw: (chart) => {
          const ctx = chart.ctx;
          const chartArea = chart.chartArea;
          const xAxis = chart.scales.x;
          const yAxis = chart.scales.y;
          
          if (!chartArea) return;
          
          const now = Date.now();
          
          ctx.save();
          
          // Past negative values (<0, before now) - light red
          if (xAxis.min < now && yAxis.min < 0) {
            const xEnd = Math.min(xAxis.max, now);
            const yEnd = Math.min(yAxis.max, 0);
            ctx.fillStyle = '#ffdddd';
            ctx.fillRect(
              xAxis.getPixelForValue(xAxis.min),
              yAxis.getPixelForValue(yEnd),
              xAxis.getPixelForValue(xEnd) - xAxis.getPixelForValue(xAxis.min),
              yAxis.getPixelForValue(yAxis.min) - yAxis.getPixelForValue(yEnd)
            );
          }
          
          // Future positive values (>0, after now) - light gray
          if (xAxis.max > now && yAxis.max > 0) {
            const xStart = Math.max(xAxis.min, now);
            const yStart = Math.max(yAxis.min, 0);
            ctx.fillStyle = '#e0e0e0';
            ctx.fillRect(
              xAxis.getPixelForValue(xStart),
              yAxis.getPixelForValue(yStart),
              xAxis.getPixelForValue(xAxis.max) - xAxis.getPixelForValue(xStart),
              yAxis.getPixelForValue(yAxis.max) - yAxis.getPixelForValue(yStart)
            );
          }
          
          // Future negative values (<0, after now) - light red-gray
          if (xAxis.max > now && yAxis.min < 0) {
            const xStart = Math.max(xAxis.min, now);
            const yEnd = Math.min(yAxis.max, 0);
            ctx.fillStyle = '#e8c8c8';
            ctx.fillRect(
              xAxis.getPixelForValue(xStart),
              yAxis.getPixelForValue(yEnd),
              xAxis.getPixelForValue(xAxis.max) - xAxis.getPixelForValue(xStart),
              yAxis.getPixelForValue(yAxis.min) - yAxis.getPixelForValue(yEnd)
            );
          }
          
          // Zero line - dark red
          if (yAxis.min <= 0 && yAxis.max >= 0) {
            ctx.strokeStyle = '#bb0000';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(
              chartArea.left,
              yAxis.getPixelForValue(0)
            );
            ctx.lineTo(
              chartArea.right,
              yAxis.getPixelForValue(0)
            );
            ctx.stroke();
          }
          
          ctx.restore();
        }
      };
      
      const chart = new Chart(ctx, {
        type: 'line',
        data: { datasets },
        plugins: [backgroundMarkingsPlugin],
        options: {
          responsive: false,
          maintainAspectRatio: false,
          scales: {
            x: {
              type: 'time',
              time: {
                unit: 'day',
                displayFormats: {
                  day: 'yyyy/MM/dd'
                }
              }
            },
            y: {
              type: 'linear',
              beginAtZero: false,
              ticks: {
                precision: 1
              }
            }
          },
          plugins: {
            legend: {
              display: true,
              position: 'bottom',
              align: 'start',
              labels: {
                boxWidth: 12,
                padding: 10,
                font: {
                  size: 12
                },
                filter: (legendItem, chartData) => {
                  return legendItem.text !== '';
                }
              }
            },
            tooltip: {
              callbacks: {
                label: (context) => {
                  const dataIndex = context.dataIndex;
                  const datasetIndex = context.datasetIndex;
                  const metadata = pointMetadata[dataIndex];
                  if (metadata && metadata.transaction) {
                    return `${metadata.balance} balance on ${new Date(context.parsed.x).toLocaleDateString()} after ${metadata.amount} posted by transaction:\n${metadata.transaction}`;
                  }
                  return context.dataset.label + ': ' + context.parsed.y;
                }
              }
            }
          },
          onClick: (event, elements) => {
            if (elements.length > 0) {
              const element = elements[0];
              const dataIndex = element.index;
              const metadata = pointMetadata[dataIndex];
              if (metadata && metadata.tindex) {
                const targetselector = '#' + metadata.tindex;
                const target = document.querySelector(targetselector);
                if (target) {
                  window.location.hash = targetselector;
                  window.scrollTo({
                    top: target.getBoundingClientRect().top + window.scrollY - 100,
                    behavior: 'smooth'
                  });
                }
              }
            }
          }
        }
      });
    } catch (error) {}
  })();
