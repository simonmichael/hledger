# Here's a (verbose) hledger config file, providing extra options/arguments.
# You can try it with --conf CONFFILE, or save it as ~/.hledger.conf
# (or ~/.config/hledger/hledger.conf, or hledger.conf in/above current directory),
# and hledger will use it automatically.
# Note automatic config files are convenient, but it's easy to confuse yourself,
# disrupt reports, or break hledger-using scripts/applications.
# If a command is not working as expected, try it with -n to disable config files,
# or run it with --debug or --debug=8 to troubleshoot.
# https://hledger.org/dev/hledger.html#config-files

###############################################################################
# 1. General options, to be added to all commands which support them.

# https://hledger.org/dev/hledger.html#output
# If you need to turn off any of these, I'd like to hear details:
--pretty     # Show prettier tables in reports ? Recommended on most systems.
#--color=no  # Disable ANSI color and font styling in the terminal ?
#--pager=no  # Disable paging of long output in the terminal ?

# Postpone balance assertions until you use -s or `hledger check assertions` ?
# It means less need to add -I while piping or fixing problems.
--ignore-assertions    # https://hledger.org/hledger.html#balance-assertions

# Always infer these things ?
# https://hledger.org/hledger.html#--infer-market-prices-market-prices-from-transactions
# https://hledger.org/hledger.html#equity-conversion-postings
# https://hledger.org/hledger.html#inferring-equity-conversion-postings
--infer-market-prices
--infer-costs
#--infer-equity


###############################################################################
# 2. Command options, to be added to specific commands.

# https://hledger.org/hledger.html#print
[print]
--explicit     # show inferred amounts

# https://hledger.org/hledger.html#help
[help]
#--man          # if you prefer man over info

# Set some defaults for the balance commands ?
# You can override these by adding more options on the command line.
#[balance]            --layout=bare --tree --depth 3
#[balancesheet]       --layout=bare --tree --depth 3
#[balancesheetequity] --layout=bare --tree --depth 3
#[cashflow]           --layout=bare --tree --depth 3
#[incomestatement]    --layout=bare --tree --depth 3


# You can also set options for add-on commands here, which works if
# you run them with hledger (`hledger ui ...`, not `hledger-ui ...`).
# Some addons (eg hledger-ui, hledger-web) also respect the general options.

# https://hledger.org/hledger-ui.html#options
# Start in the Cash accounts screen, depth-limited, hiding zeros and equity.
[ui]
--cash -3 -E not:type:e

# https://hledger.org/hledger-web.html#options
[web] --port=0 --allow edit

# https://hledger.org/scripts.html#hledger-iadd
[iadd] --date-format %Y-%m-%d

# https://hledger.org/scripts.html#hledger-interest
#[interest]
# --annual 0.05
# --30-360
# --source SRCACCT
# --target DSTACCT
# ACCT


###############################################################################
# 3. Command aliases, for your own custom hledger commands and reports.
# https://hledger.org/dev/hledger.html#command-aliases

[alias]
p   = tx              # brief print
pr  = print           # full print
pex = print --export  # lossless print

revdecades = bal type:R -2 -X$ -p 'every 10 years from 2000'  # revenue by decade

# Aliases beginning with ! are shell commands.
# These will run only from a trusted config file, which means $HOME/.hledger.conf
# or a config file specified with --conf.

# hledger commit 'MSG' - commit changed journal files in version control
commit = ! jj commit `hledger files` -m
#commit = ! git commit -p -- `hledger files`

# hledger watch HLEDGERARGS.. - rerun a report when $LEDGER_FILE changes
watch = ! hledger files | watchexec -F- -c -- hledger    

# A command can be continued on indented lines:
forecast = aregister --forecast -E
    -p today..3months

# You can build multi-command scripts with hledger run:
forecasts = run
    -- echo checking1:  -- forecast checking1
    -- echo checking2:  -- forecast checking2
    -- echo creditcard: -- forecast creditcard

# Or use shell scripts:

# cmds [REGEX] - list all or matched commands
cmds = !
 f() {
  # run hledger help commands, passing any flags to it
  o=; p=;
  for a; do case $a in -*) o="$o $a";; *) p=$a;; esac; done;
  hledger help commands --color=yes $o
  # convert OTHER ADDONS to a single column
  | awk '/^OTHER ADDONS/{c=1; print; next} /^[^ ]/{c=0} c{for(i=1;i<=NF;i++) print " " $i; next} {print}'
  # grep the name or abbreviation; highlight the matched part
  | rg -P "^\s*(\S*\K$p|\S+ \(\S*\K$p)";
 }; f
builtins = cmds --builtins
addons   = cmds --addons
aliases  = cmds --aliases
c = cmds
b = builtins
d = addons
a = aliases
