# AI usage scripts. This is the ai module of the main Justfile, so from the top directory
# run these as `just ai RECIPE`; in this directory, as `just RECIPE`.
# Recipes run in this directory.

set shell := ["bash", "-uc"]

just := 'just -f ' + source_file()

# Show help for the AI usage scripts.
help:
    #!/bin/bash
    cat <<EOS
    AI usage scripts help.
    These are in groups, corresponding to various data sources:
    1. session   - read this machine's recent claude code logs directly
    2. ccusage   - read this machine's recent claude code logs with ccusage
    3. ccusagej  - update/read a temp journal caching the above (ccusage.journal)
    4. commits   - update/read a temp csv caching git ai usage messages (aicommits.csv)
    5. aij       - update/read a permanent journal of project's overall ai usage (ai.journal)
    Notes:
    - ccusage.journal's numbers drop over time (when regenerated) as old logs get purged.
      Eg compare just ai ccusagej-monthly -Xkt -c1.kt; just ai aij-monthly -Xkt -c1.kt
    - in recent period, ccusage.journal should be similar to the usage recorded in SM's commits.
    - ai.journal should be >= the usage recorded in all commits. (It may record additional AI usage not tied to commits.)

    EOS
    #'
    {{ just }} --list --unsorted

CCPROJECTS := '~/.claude/projects'

# jq program summing output tokens in claude code transcripts, between epoch times $from and $to.
# Deduplicates by message and request id, since a response is often logged on several lines (ccusage session --id doesn't do this).
AI_OUTPUT_JQ := '[.[] | select(.message.usage) | select((.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdate) as $t | $t >= $from and $t < $to)] | unique_by([.message.id, .requestId]) | [.[].message.usage.output_tokens] | add // 0'

# Show one claude code session's output tokens (kt), including its subagents; optionally only those since a time (gdate syntax). Unlike the daily numbers, not affected by other concurrent sessions.
session SESSIONID SINCE='1970-01-01':
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    files=({{ CCPROJECTS }}/*/{{ SESSIONID }}*.jsonl)
    if [[ ${#files[@]} -ne 1 ]]; then echo "expected one transcript matching {{ SESSIONID }}, found ${#files[@]}" >&2; exit 1; fi
    main=${files[0]}
    from=$(gdate -d '{{ SINCE }}' +%s)
    cat "$main" "${main%.jsonl}"/subagents/*.jsonl \
      | jq -s -r --argjson from "$from" --argjson to 9999999999 '({{ AI_OUTPUT_JQ }}) / 1000 | "\(.) kt"'

# List the claude code sessions active on a day (default today), with their output tokens (kt) that day, and the total.
sessions DATE='today':
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    day=$(gdate -d '{{ DATE }}' +%F)
    from=$(gdate -d "$day" +%s)
    to=$(gdate -d "$day +1 day" +%s)
    for main in $(find {{ CCPROJECTS }}/ -mindepth 2 -maxdepth 2 -name '*.jsonl' -newermt "$(gdate -d @$from "+%F %T")"); do
      kt=$(cat "$main" "${main%.jsonl}"/subagents/*.jsonl | jq -s --argjson from "$from" --argjson to "$to" '({{ AI_OUTPUT_JQ }}) / 1000')
      [[ $kt == 0 ]] || printf "%8.1f kt  %s  %s\n" "$kt" "$(basename "$main" .jsonl)" "$(basename "$(dirname "$main")")"
    done | sort -rn | awk '{print} {t+=$1} END {printf "%8.1f kt  total\n", t}'

# Show today's logged local-machine claude code usage. Accepts ccusage options, like -b.
@ccusage-today *CCUSAGEOPTS:
    ccusage -O daily -s `date +%Y%m%d` {{ CCUSAGEOPTS }}

# Watch today's logged local-machine claude code usage. Accepts ccusage options, like -b.
@ccusage-watch *CCUSAGEOPTS:
    watch -n10 -c -d 'ccusage -O daily -s `date +%Y%m%d` {{ CCUSAGEOPTS }}| tail +8'

# Export ccusage's local-machine claude code usage data as CSV.
@ccusage-csv CCUSAGECMD='monthly' *CCUSAGEOPTS:
    ccusage -O {{ CCUSAGECMD }} {{ CCUSAGEOPTS }} -j | jq -r ' \
      first(.. | arrays | select(length > 0 and (.[0] | type == "object"))) \
      | [.[] | with_entries(select(.value | type != "array" and type != "object"))] \
      | (.[0] | keys_unsorted) as $k \
      | ($k | @csv), (.[] | [.[$k[]]] | @csv) \
    '

# Regenerate ccusage.journal from ccusage's data, and add lots of unit conversions.
ccusagej-regen:
    #!/usr/bin/env bash
    {
    cat <<'EOS'
    # Local user's claude code usage based on available chat logs.
    account ai
    EOS
    {{ just }} ccusage-csv daily | hledger -f csv:- --rules ccusage.rules print -c '1,000,000 t'
    } > ccusage.journal

# Run a hledger command on ccusage.journal. If you need it to be up to date, run ccusagej-regen first.
@ccusagej *HLEDGERARGS:
    hledger -f ccusage.journal {{ HLEDGERARGS }}

# Show a claude code usage balance report, vertically.
@ccusagej-bal *BALARGS:
    {{ just }} ccusagej bal --transpose -N --layout=bare {{ BALARGS }}

# Show claude code monthly usage.
@ccusagej-monthly *BALARGS:
    {{ just }} ccusagej-bal -M -b 2026 {{ BALARGS }}

# Show claude code daily usage this month.
@ccusagej-daily *BALARGS:
    {{ just }} ccusagej-bal -D -p1..tomorrow {{ BALARGS }}

# Regen ccusage.journal, then show recent daily usage.
ccusagej-recent *BALARGS:
    #!/bin/bash
    {{ just }} ccusagej-regen
    {{ just }} ccusagej-bal -DE -p-7days..tomorrow -Xkt --title "Latest_AI_usage,_$(date | sed 's/ /_/g')" {{ BALARGS }}

# Run ccusagej-recent repeatedly.
@ccusagej-recent-watch *BALARGS:
    while true; do {{ just }} ccusagej-recent -c1.kt {{ BALARGS }}; echo; read -p "press enter to update.."; done

# Save the "AI usage:" disclosure lines from commit messages to aicommits.csv.
@commits-csv:
    ../../tools/aicommits > aicommits.csv
    echo "wrote doc/ai/aicommits.csv"

# Import any new past-month summaries of commits' AI usage lines to ai.journal.
@aij-import *IMPORTARGS:
    ../../tools/aicommits | \
     hledger -f csv:- --rules aicommits.csv.rules reg ai -ME -e thismonth -O csv | \
     hledger -f ai.journal import csv:- --rules aicommits-summary.rules {{ IMPORTARGS }}

# Run a hledger command on ai.journal, and use hledger.conf.
@aij *HLEDGERARGS:
    hledger --conf hledger.conf -f ai.journal {{ HLEDGERARGS }}

# Show a project ai usage balance report.
@aij-bal *BALARGS:
    {{ just }} aij bal --transpose -N --layout=bare {{ BALARGS }}

# Show project monthly usage.
@aij-monthly *BALARGS:
    {{ just }} aij-bal -M {{ BALARGS }}

# Regenerate the reports in README.md: the content of each block between
# "<!-- generated by just ai readme -->" and "<!-- end -->" lines, in order:
# usage in Mt (with the date), equivalents, and forecasts (complete months only).
# The rest of README.md is preserved.
readme:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    report() { echo '```'; hledger --conf hledger.conf -f ai.journal "$@"; echo '```'; }
    { echo "Last updated: $(date +%Y-%m-%d)"; echo; report Mt --title=; } > "$tmp/1"
    report costs > "$tmp/2"
    report equivalents > "$tmp/3"
    report forecasts -e thismonth > "$tmp/4"
    # (For HTML tables instead, use -O html and remove their stylesheets:
    # sed -e '/^<style>/,/^<\/style>/d' -e '/^<link rel="stylesheet"/d')
    awk -v dir="$tmp" '
      /^<!-- generated by just ai readme -->/ { print; n++; f = dir "/" n
        if ((getline line < f) <= 0) { print "README.md has more generated blocks than reports" > "/dev/stderr"; exit 1 }
        print line; while ((getline line < f) > 0) print line; skip = 1; next }
      /^<!-- end -->/ { skip = 0 }
      !skip
      END { if (n != 4) { print "expected 4 generated blocks in README.md, found " n > "/dev/stderr"; exit 1 } }
    ' README.md > .README.md
    mv .README.md README.md
    echo "updated doc/ai/README.md"
