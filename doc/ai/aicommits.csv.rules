# Convert aicommits.csv to a journal of per-commit AI usage.
# aicommits.csv is generated by `just ai commits-csv`; see also `just ai help`.
# outputkt is estimated AI output in thousands of tokens, recorded here
# in the kt (kilotokens) commodity.
# Keep synced with tools/aicommits.

source ./aicommits.csv

skip 1
fields date,hash,author,provider,model,outputkt,summary,notes

# Commit messages often contain semicolons, but descriptions can't.
description %author | %hash %{replace(replace(%summary, "^; *", ""), ";", ",")}
comment     %notes
account1    (ai)
amount1     %outputkt kt
#comment1    provider:%provider, model:%model
comment1    model:%model

# Commits whose disclosure gave no token estimate: record zero.
if %outputkt ^ *$
    amount1 0 kt
