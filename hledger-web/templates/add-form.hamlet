<script>

  document.addEventListener('DOMContentLoaded', function() {

    // Set up autocomplete data
    globalThis.descriptions = #{toBloodhoundJson (toList descriptions)};
    globalThis.accounts = #{toBloodhoundJson (journalAccountNamesDeclaredOrImplied j)};

    // Initialize Bloodhound for accounts
    if (typeof Bloodhound !== 'undefined') {
      globalThis.accountsCompleter = new Bloodhound({
        datumTokenizer: Bloodhound.tokenizers.whitespace,
        queryTokenizer: Bloodhound.tokenizers.whitespace,
        local: globalThis.accounts
      });
    }
  });

  if (typeof utf8textdecoder === 'undefined') {
    window.utf8textdecoder = new TextDecoder();
  }
  function decodeBase64EncodedText(b64) {
      const unb64 = window.atob(b64);
      const arr = new Uint8Array(unb64.length);
      for (let i = 0; i < arr.length; i++) {
          arr[i] = unb64.charCodeAt(i);
      }
      return window.utf8textdecoder.decode(arr);
  }

^{extra}

<div .row>
  <div .col-md-3.col-sm-5.col-xs-6 :isJust (fvErrors dateView):.has-error>
    <div #dateWrap .form-group.input-group.date>
      ^{fvInput dateView}
      <div .input-group-text>
        <span .bi.bi-calendar aria-hidden="true">
    $maybe err <- fvErrors dateView
      <span .help-block .error-block>#{err}
  <div .col-md-9.col-sm-7.col-xs-6 :isJust (fvErrors descView):.has-error>
    <div .form-group>
      ^{fvInput descView}
    $maybe err <- fvErrors descView
      <span .help-block .error-block>#{err}

<div .account-postings>
  $forall (n, (acc, amt, accE, amtE)) <- displayRows
    <div .form-group .row .account-group style="padding-left:1em;">
      <div .col-sm-9.col-xs-9 :isJust accE:.has-error>
        <label for="account-#{n}" class="sr-only">Account #{n}</label>
        <input .account-input.form-control.input-lg type=text
          id="account-#{n}" name=account placeholder="Account #{n}" value="#{acc}">
        $maybe err <- accE
          <span .help-block .error-block>_{err}
      <div .col-sm-3.col-xs-3 :isJust amtE:.has-error>
        <label for="amount-#{n}" class="sr-only">Amount #{n}</label>
        <input .amount-input.form-control.input-lg type=text
          id="amount-#{n}" name=amount placeholder="Amount #{n}" value="#{amt}">
        $maybe err <- amtE
          <span .help-block .error-block>_{err}

<div .row>
  <div .col-sm-9.col-xs-9 style="display: flex; align-items: center; gap: 10px;">
    $if length files > 1
      Add to:
      &nbsp;
      <div style="display:inline-block; width:auto;" .form-group :isJust (fvErrors fileView):.has-error>
        ^{fvInput fileView}
        $maybe err <- fvErrors fileView
          <span .help-block .error-block>#{err}
    <button type=button .btn .btn-default .btn-lg onclick="addformAddPosting()" title="Adds a new posting row">
      <span .bi.bi-plus>
  <div .col-sm-3.col-xs-3 style="text-align: right;">
    <button type=submit .btn .btn-default .btn-lg name=submit style="font-weight:bold;">Save
