[Unit]
Description=hledger-web -- plain text accounting, made easy
Documentation=https://hledger.org/index.html
After=network.target

[Service]
# Your account environment is not available if you are not logged
# in--e.g., on system startup. This sets the variables you need.
Environment="LANG=en_US.UTF-8"
Environment="LEDGER_FILE=/fully/qualified/path/to/your/journal"

# Choose a base-url with a domain or a host ip
Environment="BASE_URL=--base-url=https://your.domain"
#Environment="BASE_URL=--host=127.0.0.1"

# The default of 'add' for a local only address or 'view' otherwise
# Enable one of the below for direct control
# Environment="CAPABILITIES=--allow=view"
# Environment="CAPABILITIES=--allow=add"
# Environment="CAPABILITIES=--allow=edit"

Environment="PORT=--port=5000"

ExecStart=/usr/local/bin/hledger-web --serve $BASE_URL $PORT $CAPABILITIES
Restart=always

[Install]
WantedBy=default.target
